{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ContractPlay",
  "version": "0.1.0",
  "identifier": "com.contractplay.bridge",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --workspace-root build && pnpm --filter @contractplay/client dev --host 0.0.0.0 --port 1420 --strictPort",
    "beforeBuildCommand": "pnpm --workspace-root build"
  },
  "app": {
    "windows": [
      {
        "title": "ContractPlay",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app"],
    "category": "Games",
    "shortDescription": "Play, learn, and review contract bridge",
    "longDescription": "A contract bridge table with configurable bots, PBN import and export, hand review, and card-play hints.",
    "copyright": "Copyright © ContractPlay contributors",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
